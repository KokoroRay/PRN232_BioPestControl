@engagement_service_HostAddress = http://localhost:5286
@customerToken = your-jwt-Customer-role-customer_id
@staffToken = your-jwt-Staff-role-StaffId
@adminToken = your-jwt-Admin

###############################################################################
# 01 — Công khai (không cần JWT)
###############################################################################

### Danh sách đánh giá theo sản phẩm
GET {{engagement_service_HostAddress}}/api/feedbacks?productId=1&page=1&pageSize=5&rating=
Accept: application/json

### Chi tiết một đánh giá
GET {{engagement_service_HostAddress}}/api/feedbacks/1
Accept: application/json

###############################################################################
# 02 — Khách hàng (JWT: Customer; Admin có thể gửi/sửa hộ với CustomerId)
###############################################################################

### Tạo đánh giá (Customer)
POST {{engagement_service_HostAddress}}/api/feedbacks
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "productId": 1,
  "orderId": 1,
  "customerId": 0,
  "rating": 5,
  "comment": "Rất tốt",
  "imageUrls": [],
  "tagsIds": []
}

### Cập nhật đánh giá (Customer — chủ sở hữu)
PUT {{engagement_service_HostAddress}}/api/feedbacks/1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "rating": 4,
  "comment": "Đã chỉnh sửa",
  "imageUrls": [],
  "tagsIds": []
}

###############################################################################
# 03 — Nhân viên & Quản trị (JWT: Staff hoặc Admin)
###############################################################################

### Danh sách quản lý (lọc)
GET {{engagement_service_HostAddress}}/api/feedbacks/manage?productId=&customerId=&rating=&hasReply=
Authorization: Bearer {{staffToken}}
Accept: application/json

### Trả lời đánh giá
POST {{engagement_service_HostAddress}}/api/feedbacks/1/replies
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "reply": "Cảm ơn bạn đã đánh giá."
}

###############################################################################
# 04 — Chỉ Admin (JWT: Admin)
###############################################################################

### Xóa đánh giá
DELETE {{engagement_service_HostAddress}}/api/feedbacks/1
Authorization: Bearer {{adminToken}}

###